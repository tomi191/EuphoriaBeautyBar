# Шаблон за променливите на средата. Копирай в .env.local и попълни реалните стойности.
# Всички стойности тук са placeholder-и. Реалните ключове живеят само в .env.local.

# ---------- Сайт ----------
# Публичният адрес на сайта. NEXT_PUBLIC_* стойностите се изпращат към браузъра.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- База данни (Supabase Postgres) ----------
# Runtime връзка през transaction pooler (порт 6543). Изисква prepare: false.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Session pooler (порт 5432). Използва се от drizzle.config.ts и DB скриптовете (миграции, seed, journey).
DATABASE_URL_SESSION=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Паролата може да съдържа знака #. В URL трябва да се кодира като %23 (например ab%23cd).

# ---------- Supabase ----------
# Проектният URL. Публичен, използва се и от браузъра (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Публичният anon ключ на Supabase. Резервен, в момента не се чете директно от кода.
SUPABASE_ANON_KEY=<supabase-anon-key>
# Service role ключ. Само на сървъра: качване в Storage (галерия, снимки на екипа, blog изображения). Никога не се изпраща към браузъра.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# ---------- Auth (Better Auth) ----------
# Тайна за подписване на сесиите. В production трябва да е силна случайна стойност (напр. openssl rand -hex 32).
BETTER_AUTH_SECRET=<random-64-char-secret>
# Базовият URL на auth системата. Трябва да съвпада с адреса, на който работи приложението.
BETTER_AUTH_URL=http://localhost:3000
# Първият администраторски акаунт. Използва се само от seed скрипта (scripts/seed.ts), не от приложението.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-admin-password>
ADMIN_NAME=<admin-display-name>

# ---------- Имейл (Resend) ----------
# API ключ за изпращане на имейли (контактна форма, потвърждения за записване).
RESEND_API_KEY=re_<your-resend-api-key>
# Адрес, на който пристигат съобщенията от контактната форма.
CONTACT_TO_EMAIL=<reception@example.com>
# Адрес на подателя (трябва да е верифициран домейн в Resend).
CONTACT_FROM_EMAIL=<hello@example.com>

# ---------- Cron ----------
# Тайна, с която Vercel cron заявките се удостоверяват към /api/cron/*. Без нея cron endpoint-ите отказват.
CRON_SECRET=<random-cron-secret>

# ---------- Push известия (VAPID) ----------
# Двойката ключове за Web Push. Генерира се веднъж и не се сменя без нужда.
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
# Същата стойност като VAPID_PUBLIC_KEY. Нужна е в браузъра за абониране за push известия.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
# Контакт за push сървърите, във формат mailto:... или https://...
VAPID_SUBJECT=mailto:<contact@example.com>

# ---------- AI ----------
# OpenRouter ключ за генериране на блог теми, ключови думи и текст (blog-writer).
OPENROUTER_API_KEY=<openrouter-api-key>
# Идентификаторът на модела в OpenRouter, който пише блог статиите (напр. provider/model-name).
BLOG_OPENROUTER_MODEL=<openrouter-model-id>
# KIE.ai ключ за генериране на изображения (обложки и вътрешни снимки на блога, снимки на услуги).
KIE_AI_API_KEY=<kie-ai-api-key>

# ---------- Google ----------
# Place ID на бизнеса в Google. Използва се за синхронизация на отзивите и в админ страниците.
GOOGLE_PLACE_ID=<google-place-id>
# ID на Featurable widget-а, през който се синхронизират Google отзивите (cron).
FEATURABLE_WIDGET_ID=<featurable-widget-id>

# ---------- Telegram ----------
# Токен на Telegram бота (известия и интерактивният график). Взема се от @BotFather.
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
# Тайна, която Telegram изпраща в заглавката при webhook заявките. Проверява се в /api/telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=<random-webhook-secret>
# Потребителското име на бота без @. Използва се за линкове в админ панела.
TELEGRAM_BOT_USERNAME=<bot_username>
